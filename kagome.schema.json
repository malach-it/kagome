{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "clients": {
      "description": "OAuth clients accepted by the authorization server.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ClientConfig"
      },
      "minItems": 1
    },
    "credentials": {
      "description": "Verifiable credential configurations advertised and issued by the server.",
      "type": "array",
      "default": [
        {
          "credential_configuration_id": "UniversityDegreeCredential",
          "name": "University Degree Credential",
          "type": [
            "UniversityDegreeCredential"
          ],
          "vct": "UniversityDegreeCredential"
        }
      ],
      "items": {
        "$ref": "#/$defs/CredentialConfig"
      },
      "minItems": 1
    },
    "crypto": {
      "description": "External file containing encryption secrets and signing key pairs.",
      "$ref": "#/$defs/CryptoConfig"
    },
    "presentation_definitions": {
      "description": "Presentation definitions selected by OAuth scope identifiers.",
      "type": "array",
      "default": [
        {
          "definition": {
            "id": "credential_presentation",
            "input_descriptors": [
              {
                "constraints": {
                  "fields": [
                    {
                      "filter": {
                        "contains": {
                          "const": "UniversityDegreeCredential"
                        },
                        "type": "array"
                      },
                      "path": [
                        "$.vc.type"
                      ]
                    },
                    {
                      "path": [
                        "$.vc.credentialSubject.id"
                      ]
                    }
                  ]
                },
                "format": {
                  "jwt_vc": {
                    "alg": [
                      "EdDSA"
                    ]
                  }
                },
                "id": "credential"
              }
            ]
          },
          "identifier": "credential_presentation"
        }
      ],
      "items": {
        "$ref": "#/$defs/PresentationDefinitionConfig"
      },
      "minItems": 1
    },
    "server": {
      "description": "HTTP server settings.",
      "$ref": "#/$defs/ServerConfig"
    },
    "tokens": {
      "description": "OAuth token lifetime and authorization-code chain settings.",
      "$ref": "#/$defs/TokenTtlsConfig"
    }
  },
  "additionalProperties": false,
  "required": [
    "server",
    "crypto",
    "clients"
  ],
  "$defs": {
    "ClientConfig": {
      "type": "object",
      "properties": {
        "client_id": {
          "description": "Public identifier of the OAuth client.",
          "type": "string",
          "minLength": 1
        },
        "client_secret": {
          "description": "Secret used to authenticate the OAuth client at the token endpoint.",
          "type": "string",
          "minLength": 1
        },
        "federated_server": {
          "description": "Upstream OAuth server used to federate identities for this client.",
          "anyOf": [
            {
              "$ref": "#/$defs/FederatedServerConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "password_file": {
          "description": "Optional nginx-style resource-owner password file.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "public": {
          "description": "Host used to resolve dynamic `username@host` client identifiers.",
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "minLength": 1
        },
        "qr_code": {
          "description": "Render wallet authorization URLs as QR-code HTML instead of redirects.",
          "type": "boolean",
          "default": false
        },
        "redirect_uris": {
          "description": "Exact redirect URIs accepted for authorization responses.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "require_wallet_binding": {
          "description": "Require wallet proofs and presentations to be bound to the public key\nfrom the ID token carried by the incoming authorization code.",
          "type": "boolean",
          "default": false
        },
        "scopes": {
          "description": "OAuth scopes this client may request.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supported_grant_types": {
          "description": "OAuth grant types this client may use.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GrantType"
          }
        },
        "supported_response_types": {
          "description": "OAuth response types this client may request.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResponseType"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "client_id",
        "client_secret",
        "redirect_uris"
      ]
    },
    "CredentialConfig": {
      "type": "object",
      "properties": {
        "credential_configuration_id": {
          "description": "Identifier used in issuer metadata, offers, and credential requests.",
          "type": "string",
          "minLength": 1
        },
        "name": {
          "description": "Human-readable credential name advertised in issuer metadata.",
          "type": "string",
          "minLength": 1
        },
        "type": {
          "description": "W3C Verifiable Credential types carried by the credential.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "vct": {
          "description": "Verifiable credential type identifier carried by the credential.",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "credential_configuration_id",
        "name",
        "vct",
        "type"
      ]
    },
    "CryptoConfig": {
      "type": "object",
      "properties": {
        "key_file": {
          "description": "YAML file loaded once at startup with encryption secrets and signing keys.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "key_file"
      ]
    },
    "FederatedIdentityClaimConfig": {
      "type": "object",
      "properties": {
        "claim": {
          "description": "Dot-separated JSON claim path read from the endpoint response.",
          "type": "string",
          "minLength": 1
        },
        "credential": {
          "description": "Credential configuration identifiers whose subjects include the attribute.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "id_token": {
          "description": "Include the attribute in generated ID tokens.",
          "type": "boolean",
          "default": false
        },
        "target": {
          "description": "Resource-owner attribute populated from the claim.",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "claim",
        "target"
      ]
    },
    "FederatedIdentityEndpointConfig": {
      "type": "object",
      "properties": {
        "claims": {
          "description": "Claims copied from the endpoint response into resource-owner attributes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FederatedIdentityClaimConfig"
          },
          "minItems": 1
        },
        "endpoint": {
          "description": "Endpoint called with the federated bearer access token.",
          "type": "string",
          "format": "uri",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "endpoint",
        "claims"
      ]
    },
    "FederatedServerConfig": {
      "type": "object",
      "properties": {
        "authorize_endpoint": {
          "description": "Federated server endpoint to which authorization requests are sent.",
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "client_id": {
          "description": "Client identifier used to authenticate Kagome to the federated server.",
          "type": "string",
          "minLength": 1
        },
        "client_secret": {
          "description": "Client secret used to authenticate Kagome to the federated server.",
          "type": "string",
          "minLength": 1
        },
        "endpoints": {
          "description": "Federated endpoints used to obtain identity claims with the access token.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FederatedIdentityEndpointConfig"
          },
          "minItems": 1
        },
        "token_endpoint": {
          "description": "Federated server endpoint at which authorization codes are exchanged.",
          "type": "string",
          "format": "uri",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "client_id",
        "client_secret",
        "authorize_endpoint",
        "token_endpoint",
        "endpoints"
      ]
    },
    "GrantType": {
      "type": "string",
      "enum": [
        "authorization_code",
        "client_credentials",
        "code_chain",
        "implicit",
        "urn:ietf:params:oauth:grant-type:pre-authorized_code",
        "password"
      ]
    },
    "PresentationDefinitionConfig": {
      "type": "object",
      "properties": {
        "definition": {
          "description": "Presentation Exchange definition sent to the wallet and enforced on response."
        },
        "identifier": {
          "description": "OAuth scope value used to select the presentation definition.",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "identifier",
        "definition"
      ]
    },
    "RateLimitConfig": {
      "type": "object",
      "properties": {
        "count": {
          "description": "Target number of requests per configured time unit.",
          "type": "integer",
          "format": "uint",
          "maximum": 100000,
          "minimum": 1
        },
        "memory_length": {
          "description": "Number of time-unit buckets retained per client IP.",
          "type": "integer",
          "format": "uint",
          "maximum": 10000,
          "minimum": 1
        },
        "penality": {
          "description": "Delay multiplier, in milliseconds, applied to the historical overload factor.",
          "type": "integer",
          "format": "uint64",
          "maximum": 600000,
          "minimum": 0
        },
        "time_unit": {
          "description": "Time unit used to group request history.",
          "$ref": "#/$defs/RateLimitTimeUnit"
        },
        "timeout": {
          "description": "Reject requests whose calculated delay reaches this value, in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "maximum": 600000,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "count",
        "time_unit",
        "penality",
        "timeout",
        "memory_length"
      ]
    },
    "RateLimitTimeUnit": {
      "type": "string",
      "enum": [
        "millisecond",
        "second",
        "minute"
      ]
    },
    "ReplayProtectionConfig": {
      "anyOf": [
        {
          "description": "Enables replay protection with the default artifact capacity, or disables it when false.",
          "type": "boolean"
        },
        {
          "description": "Enables replay protection with this maximum number of tracked artifacts.",
          "type": "integer",
          "format": "uint",
          "minimum": 1
        }
      ]
    },
    "ResponseType": {
      "type": "string",
      "enum": [
        "code",
        "id_token",
        "urn:ietf:params:oauth:response-type:pre-authorized_code",
        "token",
        "vp_token"
      ]
    },
    "ServerConfig": {
      "type": "object",
      "properties": {
        "address": {
          "description": "Socket address on which the HTTP server listens.",
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "description": "Public HTTP origin used to construct callback URLs.",
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "rate_limit": {
          "description": "Global per-IP request throttling policy.",
          "$ref": "#/$defs/RateLimitConfig"
        },
        "replay_protection": {
          "description": "Enable process-local replay protection for short-lived protocol artifacts.",
          "$ref": "#/$defs/ReplayProtectionConfig"
        },
        "workers": {
          "description": "Number of HTTP request worker threads.",
          "type": "integer",
          "format": "uint",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "address",
        "issuer",
        "workers"
      ]
    },
    "TokenTtlsConfig": {
      "type": "object",
      "properties": {
        "access_token_ttl": {
          "description": "Lifetime of an access token, in seconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "authorization_code_chain_max_depth": {
          "description": "Maximum number of nested authorization codes accepted in one chain.",
          "type": "integer",
          "format": "uint",
          "default": 8,
          "maximum": 32,
          "minimum": 1
        },
        "authorization_code_ttl": {
          "description": "Lifetime of an authorization code, in seconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "federation_state_ttl": {
          "description": "Lifetime of encrypted federation state, in seconds.",
          "type": "integer",
          "format": "uint64",
          "default": 300,
          "minimum": 1
        },
        "id_token_ttl": {
          "description": "Lifetime of an ID token, in seconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "pre_authorized_code_ttl": {
          "description": "Lifetime of a pre-authorized code, in seconds.",
          "type": "integer",
          "format": "uint64",
          "default": 300,
          "minimum": 1
        },
        "presentation_state_ttl": {
          "description": "Lifetime of encrypted presentation state, in seconds.",
          "type": "integer",
          "format": "uint64",
          "default": 300,
          "minimum": 1
        },
        "siopv2_state_ttl": {
          "description": "Lifetime of encrypted SIOPv2 state, in seconds.",
          "type": "integer",
          "format": "uint64",
          "default": 300,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "access_token_ttl",
        "authorization_code_ttl",
        "id_token_ttl"
      ]
    }
  }
}
