%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    begin[GET /siopv2-request] --> authorize[Run common authorize resource pipeline]
    authorize -- error --> request_error["`**HTTP 400** HTML authorization error`"]
    authorize -- ok --> state["siopv2_state::generate"]
    state -- error --> request_error
    state -- ok --> request_object["siopv2_request::generate"]
    request_object -- error --> request_error
    request_object -- ok --> authorization["`**HTTP 302** wallet redirect or **HTTP 200** QR relay with nonce and state only in signed request`"]
    authorization --> wallet{Wallet error or id_token?}
    wallet -- error --> error_context["siopv2_state::validate"]
    wallet -- id_token --> error_context
    error_context -- valid state with redirect URI --> trusted[Remember trusted client redirect URI and state]
    error_context -- missing, invalid, or no redirect URI --> untrusted[No trusted error redirect]
    trusted --> encoding["self_issued_id_token::validate_encoding"]
    untrusted --> encoding
    encoding -- error --> response_error
    encoding -- ok --> restore["siopv2_state::validate"]
    restore -- error --> response_error
    restore -- ok --> kind{Wallet error or id_token?}
    kind -- error --> wallet_error["self_issued_id_token::validate_wallet_error"]
    wallet_error -- error --> response_error
    wallet_error -- ok --> consume_error_state["siopv2_state::consume"]
    consume_error_state -- replay or storage error --> response_error
    consume_error_state -- consumed --> wallet_redirect["`**HTTP 302** client wallet-error redirect`"]
    kind -- id_token --> id_token["self_issued_id_token::validate"]
    id_token -- error --> response_error
    id_token -- ok --> consume_id_state["siopv2_state::consume"]
    consume_id_state -- replay or storage error --> response_error
    consume_id_state -- consumed --> continuation[Build authenticated continuation and run common authorize resource pipeline]
    continuation -- error --> response_error
    continuation --> continuation_flow{Continuation flow?}
    continuation_flow -- federated client --> federation_code["authorization_code::generate"]
    federation_code -- error --> response_error
    federation_code -- ok --> federated_authorize["federated_server::authorize"]
    federated_authorize -- error --> response_error
    federated_authorize -- ok --> federation_redirect["`**HTTP 302** upstream authorization redirect with encrypted original request and wallet-bound code`"]
    continuation_flow -- OAuth or OpenID4VP --> selected_response[Run selected authorization response pipeline]
    selected_response -- error --> selected_failure{Active endpoint?}
    selected_response -- ok --> consume["authorization_code::consume_optional"]
    consume -- replay or storage error --> selected_failure
    consume -- absent or authorization code consumed --> response_kind{Generated response kind?}
    response_kind -- OAuth --> identity_success["`**HTTP 302** requested OAuth response`"]
    response_kind -- OpenID4VP --> presentation_success["`**HTTP 302** wallet presentation request or **HTTP 200** QR relay`"]
    response_kind -- pre-authorized code --> credential_offer["`**HTTP 302** credential offer or **HTTP 200** credential-offer QR relay`"]
    continuation_flow -- pre-authorized code --> continuation_code["authorization_code::generate"]
    continuation_code -- error --> response_error
    continuation_code -- ok --> authorize_redirect["`**HTTP 302** /authorize continuation carrying an unconsumed SIOPv2 authorization code`"]
    authorize_redirect --> authorize_continuation[GET /authorize continuation]
    authorize_continuation --> authorize_pipeline[Run common authorize resource pipeline]
    authorize_pipeline -- error --> authorize_failure
    authorize_pipeline -- authenticated --> selected_response
    authorize_pipeline -- unauthenticated --> continuation_authentication{Federated client?}
    continuation_authentication -- no --> local_authentication["`**HTTP 501** local authentication not implemented`"]
    continuation_authentication -- yes --> continuation_federation["`**HTTP 302** upstream authorization redirect`"]
    continuation_federation --> federation_callback[GET /federation_callback]
    federation_callback --> callback_pipeline[Run federation callback and common authorize resource pipelines]
    callback_pipeline -- error --> authorize_failure
    callback_pipeline -- authenticated --> selected_response
    selected_failure -- /siopv2-response --> response_error
    selected_failure -- /authorize or /federation_callback --> authorize_failure
    authorize_failure[Authorization continuation error] --> authorize_error_destination{Trusted redirect URI and state?}
    authorize_error_destination -- yes --> authorize_error_redirect["`**HTTP 302** authorization error with exact state`"]
    authorize_error_destination -- no --> authorize_error_html["`**HTTP 400** HTML authorization error`"]
    response_error[Error response] --> destination{Trusted error context remembered?}
    destination -- yes --> error_redirect["`**HTTP 302** client redirect with error, description, and state`"]
    destination -- no --> html_error["`**HTTP 400** HTML error page`"]
