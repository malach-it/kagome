flowchart TD
    start[Request /siopv2-request] --> method{GET?}
    method -- no --> not_found["`**HTTP 404** not found`"]
    method -- yes --> response_type["response_type::validate"]
    response_type -- error --> request_error["`**HTTP 400** HTML authorization error`"]
    response_type -- ok --> client["client_credentials::validate"]
    client -- error --> request_error
    client -- ok --> scope["scope::validate"]
    scope -- error --> request_error
    scope -- ok --> pkce["pkce::validate"]
    pkce -- error --> request_error
    pkce -- ok --> code["authorization_code::validate_optional"]
    code -- invalid, oversized, or excessive depth --> request_error
    code -- absent or valid within depth limit --> policy["metadata_policy::validate"]
    policy -- error --> request_error
    policy -- ok --> state["siopv2_state::generate"]
    state -- error --> request_error
    state -- ok --> request_object["siopv2_request::generate"]
    request_object -- error --> request_error
    request_object -- ok --> success["`**HTTP 302** wallet redirect or **HTTP 200** QR relay`"]
