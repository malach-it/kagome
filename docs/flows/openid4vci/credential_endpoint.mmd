%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    start[Request /credential] --> method{Method?}
    method -- unsupported --> not_found["`**HTTP 404** not found`"]
    method -- OPTIONS --> preflight["`**HTTP 204** CORS preflight response`"]
    method -- POST --> host{Host present and valid?}
    host -- no --> request_error["`**HTTP 400** invalid_request with CORS header`"]
    host -- yes --> bearer{Bearer access token valid?}
    bearer -- no --> bearer_error["`**HTTP 401** invalid_token with CORS header`"]
    bearer -- yes --> media{Content-Type is application/json?}
    media -- no --> credential_error["`**HTTP 400** invalid_credential_request with CORS header`"]
    media -- yes --> configuration{Credential identifier present and known?}
    configuration -- no --> credential_error
    configuration -- yes --> authorized{Token authorizes configuration?}
    authorized -- no --> bearer_error
    authorized -- yes --> proof{Optional wallet JWT proof valid?}
    proof -- no --> credential_error
    proof -- yes --> generate{Ed25519 jwt_vc generated for proof or token subject?}
    generate -- no --> generation_error["`**HTTP 400** invalid_token_response with CORS header`"]
    generate -- yes --> success["`**HTTP 200** jwt_vc credential with CORS header`"]
