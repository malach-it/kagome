%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    start[Request /credential] --> method{Method?}
    method -- unsupported --> not_found["`**HTTP 404** not found`"]
    method -- OPTIONS --> preflight_origin{Configured CORS origin allowed?}
    preflight_origin -- yes --> preflight["`**HTTP 204** CORS preflight response`"]
    preflight_origin -- no --> plain_preflight["`**HTTP 204** response without CORS headers`"]
    method -- POST --> issuer["credential_issuer::validate"]
    issuer -- error --> credential_error_origin
    issuer -- ok --> bearer["credential_access_token::validate"]
    bearer -- error --> credential_error_origin
    bearer -- ok --> configuration["credential_issuer::validate_configuration"]
    configuration -- error --> credential_error_origin
    configuration -- ok --> proof["credential_proof::validate"]
    proof -- error --> credential_error_origin
    proof -- valid with matching c_nonce --> consume["credential_access_token::consume_nonce"]
    consume -- replay or storage error --> credential_error_origin
    consume -- first use --> generate["verifiable_credential::generate"]
    generate -- error --> credential_error_origin
    generate -- ok --> success_origin{Configured CORS origin allowed?}
    credential_error_origin{Configured CORS origin allowed?} -- yes --> cors_error["`**HTTP 400/401** credential error with CORS header`"]
    credential_error_origin -- no --> credential_error["`**HTTP 400/401** credential error without CORS header`"]
    success_origin -- yes --> cors_success["`**HTTP 200** jwt_vc credential with CORS header`"]
    success_origin -- no --> success["`**HTTP 200** jwt_vc credential without CORS header`"]
