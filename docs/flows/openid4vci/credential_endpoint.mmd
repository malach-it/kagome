%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    start[Request /credential] --> method{Method?}
    method -- unsupported --> not_found["`**HTTP 404** not found`"]
    method -- OPTIONS --> preflight["`**HTTP 204** CORS preflight response`"]
    method -- POST --> issuer["credential_issuer::validate"]
    issuer --> bearer["credential_access_token::validate"]
    bearer -- error --> credential_error["`**HTTP 400/401** credential error with CORS header`"]
    bearer -- ok --> configuration["credential_issuer::validate_configuration"]
    configuration -- error --> credential_error
    configuration -- ok --> proof["credential_proof::validate"]
    proof -- error --> credential_error
    proof -- valid with matching c_nonce --> generate["verifiable_credential::generate"]
    generate -- error --> credential_error
    generate -- ok --> success["`**HTTP 200** jwt_vc credential with CORS header`"]
