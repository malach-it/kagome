%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    endpoint[GET /credential-offer] --> host{Host valid?}
    host -- no --> offer_error["`**HTTP 400** invalid_request`"]
    host -- yes --> encrypt{COSE pre-authorized code generated?}
    authorize[GET or POST /authorize with pre-authorized-code response type] --> authorize_valid{Registered client or public username@host with matching redirect?}
    authorize_valid -- no --> authorize_error["`**HTTP 400** HTML authorization error or **HTTP 302** error redirect`"]
    authorize_valid -- yes --> authenticated{Resource owner authenticated?}
    authenticated -- no --> authentication["`**HTTP 501** local authentication not implemented or **HTTP 302** federation redirect`"]
    authenticated -- yes --> binding{Wallet binding disabled or code contains valid ID-token public key?}
    binding -- no --> authorize_error
    binding -- yes --> encrypt
    encrypt -- no --> generation_error["`**HTTP 400** invalid_token_response`"]
    encrypt -- yes --> delivery{Offer source?}
    delivery -- credential-offer endpoint --> offer["`**HTTP 200** credential offer`"]
    delivery -- authorize response --> authorize_offer["`**HTTP 302** redirect with credential_offer`"]
    offer --> token[POST /token with pre-authorized-code grant]
    authorize_offer --> token
    token --> code{Encrypted code present and valid?}
    code -- no --> token_error["`**HTTP 400** invalid_request or invalid_grant`"]
    code -- yes --> key{Binding policy and ID-token key claims valid?}
    key -- no --> token_error
    key -- yes --> tx_present{Transaction code supplied?}
    tx_present -- no --> access{Credential access token generated?}
    tx_present -- yes --> tx_valid{Transaction code valid?}
    tx_valid -- no --> token_error
    tx_valid -- yes --> access
    access -- no --> generation_error
    access -- yes --> token_success["`**HTTP 200** bearer access token with authorization details`"]
    token_success --> credential_request[Request /credential]
    credential_request --> credential_method{Method?}
    credential_method -- OPTIONS --> credential_preflight["`**HTTP 204** CORS preflight response`"]
    credential_method -- unsupported --> credential_not_found["`**HTTP 404** not found`"]
    credential_method -- POST --> credential[Validate credential request]
    credential --> bearer{Bearer token valid?}
    bearer -- no --> bearer_error["`**HTTP 401** invalid_token with CORS header`"]
    bearer -- yes --> configuration{JSON request has authorized credential identifier?}
    configuration -- no --> credential_error["`**HTTP 400** credential request error with CORS header`"]
    configuration -- yes --> required{Binding policy permits missing proof?}
    required -- no --> credential_error
    required -- yes --> proof{Wallet JWT proof and optional ID-token signature valid?}
    proof -- no --> credential_error
    proof -- yes --> issue{Ed25519 jwt_vc generated for proof or token subject?}
    issue -- no --> generation_error
    issue -- yes --> success["`**HTTP 200** jwt_vc credential with CORS header`"]
