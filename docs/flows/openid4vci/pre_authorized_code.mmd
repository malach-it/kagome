%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    start[GET /credential-offer] --> host{Host valid?}
    host -- no --> offer_error["`**HTTP 400** invalid_request`"]
    host -- yes --> encrypt{COSE pre-authorized code generated?}
    encrypt -- no --> generation_error["`**HTTP 400** invalid_token_response`"]
    encrypt -- yes --> offer["`**HTTP 200** credential offer`"]
    offer --> token[POST /token with pre-authorized-code grant]
    token --> code{Encrypted code present and valid?}
    code -- no --> token_error["`**HTTP 400** invalid_request or invalid_grant`"]
    code -- yes --> tx{Transaction code present and valid?}
    tx -- no --> token_error
    tx -- yes --> access{Credential access token generated?}
    access -- no --> generation_error
    access -- yes --> token_success["`**HTTP 200** bearer access token`"]
    token_success --> credential[POST /credential]
    credential --> bearer{Bearer token valid?}
    bearer -- no --> bearer_error["`**HTTP 401** invalid_token`"]
    bearer -- yes --> configuration{JSON request has authorized configuration?}
    configuration -- no --> credential_error["`**HTTP 400** credential request error`"]
    configuration -- yes --> issue{Ed25519 JWT VC generated?}
    issue -- no --> generation_error
    issue -- yes --> success["`**HTTP 200** credentials array`"]
