%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    authorize[GET /authorize with pre-authorized_code] --> authorize_pipeline[Run common authorize resource pipeline]
    authorize_pipeline -- error --> authorize_error["`**HTTP 400** HTML authorization error`"]
    authorize_pipeline -- unauthenticated --> authentication["`**HTTP 501** local authentication or **HTTP 302** federation redirect`"]
    authorize_pipeline -- authenticated --> generate
    generate -- error --> generation_error["`**HTTP 400** invalid_token_response`"]
    generate -- authorize --> authorize_offer["`**HTTP 302** credential offer with exact state or **HTTP 200** QR relay`"]
    authorize_offer --> token[POST /token with pre-authorized-code grant]
    token --> grant["grant_type::validate"]
    grant -- error --> token_error["`**HTTP 400** OAuth error`"]
    grant -- pre-authorized_code --> code["pre_authorized_code::validate"]
    code -- error --> token_error
    code -- ok --> consume["pre_authorized_code::consume"]
    consume -- replay or storage error --> token_error
    consume -- ok --> access["credential_access_token::generate"]
    access -- error --> token_error
    access -- ok --> token_success["`**HTTP 200** credential access token, c_nonce, and authorization details`"]
    token_success --> credential_request[Request /credential]
    credential_request --> credential_issuer["credential_issuer::validate"]
    credential_issuer --> bearer["credential_access_token::validate"]
    bearer -- error --> credential_error["`**HTTP 400/401** credential error with CORS header`"]
    bearer -- ok --> configuration["credential_issuer::validate_configuration"]
    configuration -- error --> credential_error
    configuration -- ok --> proof["credential_proof::validate"]
    proof -- error --> credential_error
    proof -- valid with matching c_nonce --> consume_nonce["credential_access_token::consume_nonce"]
    consume_nonce -- replay or storage error --> credential_error
    consume_nonce -- first use --> issue["verifiable_credential::generate"]
    issue -- error --> credential_error
    issue -- ok --> success["`**HTTP 200** jwt_vc credential with CORS header`"]
