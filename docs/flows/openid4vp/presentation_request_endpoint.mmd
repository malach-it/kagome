%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    start[Request /authorize with response_type vp_token] --> method{GET?}
    method -- no --> not_found["`**HTTP 404** not found`"]
    method -- yes --> response_type["response_type::validate"]
    response_type -- error --> authorize_error
    response_type -- ok --> client["client_credentials::validate"]
    client -- error --> authorize_error
    client -- ok --> scope["scope::validate"]
    scope -- error --> authorize_error
    scope -- ok --> pkce["pkce::validate"]
    pkce -- error --> authorize_error
    pkce -- ok --> code["authorization_code::validate_optional"]
    code -- invalid, oversized, or excessive depth --> authorize_error
    code -- absent or valid within depth limit --> policy["metadata_policy::validate"]
    policy -- error --> authorize_error
    policy -- ok --> authentication{Federated client authenticated?}
    authentication -- no --> federate["federated_server::authorize"]
    federate -- error --> authorize_error
    federate -- ok --> federation_redirect["`**HTTP 302** federated authorize endpoint`"]
    authentication -- yes or local client --> verifier["verifier::validate"]
    verifier -- error --> authorize_error
    verifier -- ok --> issuer["credential_issuer::validate"]
    issuer -- error --> authorize_error
    issuer -- ok --> definition["presentation_definition::select"]
    definition -- error --> authorize_error
    definition -- ok --> state["presentation_state::generate"]
    state -- error --> authorize_error
    state -- ok --> request_object["presentation_request::generate"]
    request_object -- error --> authorize_error
    request_object -- ok --> success["`**HTTP 302** wallet redirect or **HTTP 200** QR relay with nonce and state only in signed request`"]
    authorize_error{Trusted redirect URI and state?}
    authorize_error -- yes --> redirect_error["`**HTTP 302** authorization error with exact state`"]
    authorize_error -- no --> html_error["`**HTTP 400** authorize HTML error`"]
