%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    begin[GET /authorize with vp_token] --> response_type["response_type::validate"]
    response_type -- error --> request_error
    response_type -- ok --> request_client["client_credentials::validate"]
    request_client -- error --> request_error
    request_client -- ok --> request_scope["scope::validate"]
    request_scope -- error --> request_error
    request_scope -- ok --> pkce["pkce::validate"]
    pkce -- error --> request_error
    pkce -- ok --> previous["authorization_code::validate_optional"]
    previous -- invalid, oversized, or excessive depth --> request_error
    previous -- absent or valid within depth limit --> policy["metadata_policy::validate"]
    policy -- error --> request_error
    policy -- ok --> authentication{Federated client authenticated?}
    authentication -- no --> federate["federated_server::authorize"]
    federate -- error --> request_error
    federate -- ok --> federation_redirect["`**HTTP 302** federated authorize endpoint`"]
    authentication -- yes or local client --> verifier["verifier::validate"]
    verifier -- error --> request_error
    verifier -- ok --> issuer["credential_issuer::validate"]
    issuer -- error --> request_error
    issuer -- ok --> definition["presentation_definition::select"]
    definition -- error --> request_error
    definition -- ok --> state["presentation_state::generate"]
    state -- error --> request_error
    state -- ok --> request_object["presentation_request::generate"]
    request_object -- error --> request_error
    request_object -- ok --> authorization["`**HTTP 302** wallet redirect or **HTTP 200** QR relay with nonce and state only in signed request`"]
    authorization --> wallet{Wallet error or presentation?}
    wallet -- error --> encoding["presentation_submission::validate_encoding"]
    wallet -- presentation --> encoding
    encoding -- error --> local_error["`**HTTP 400** local HTML error`"]
    encoding -- ok --> restore["presentation_state::validate"]
    restore -- error --> local_error
    restore -- ok --> client["client_credentials::validate"]
    client -- error --> local_error
    client -- ok --> kind{Wallet error or presentation?}
    kind -- error --> wallet_error["presentation_submission::validate_wallet_error"]
    kind -- presentation --> submission["presentation_submission::validate"]
    submission -- ok --> presentation["verifiable_presentation::validate"]
    presentation -- ok --> consume_presentation["presentation_state::consume"]
    consume_presentation -- replay or storage error --> response_error
    consume_presentation -- consumed --> code["authorization_code::generate"]
    wallet_error -- ok --> consume_error["presentation_state::consume"]
    consume_error -- replay or storage error --> response_error
    consume_error -- consumed --> error_redirect["`**HTTP 302** client wallet-error redirect`"]
    code -- ok --> success["`**HTTP 302** trusted redirect URI with code and state`"]
    wallet_error -- error --> response_error["`**HTTP 302** trusted error redirect`"]
    submission -- error --> response_error
    presentation -- error --> response_error
    code -- error --> response_error
    request_error{Trusted redirect URI and state?}
    request_error -- yes --> request_redirect_error["`**HTTP 302** authorization error with exact state`"]
    request_error -- no --> request_html_error["`**HTTP 400** authorization HTML error`"]
