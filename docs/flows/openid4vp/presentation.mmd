%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    begin[Verifier creates presentation request] --> verifier[Use configured issuer as verifier]
    verifier --> issuer{Credential issuer Host valid?}
    issuer -- no --> request_error["`**HTTP 400** invalid_request`"]
    issuer -- yes --> policy{Wallet binding policy satisfied by code ID-token key?}
    policy -- no --> request_error
    policy -- yes --> protect{Encrypt fresh nonce, ID-token key, and context in COSE state?}
    protect -- no --> generation_error["`**HTTP 400** invalid_token_response`"]
    protect -- yes --> sign{Sign presentation request object?}
    sign -- no --> generation_error
    sign -- yes --> authorization["`**HTTP 302** redirect URI with client_id, response_type, state-bound callback, and request JWT`"]
    authorization --> wallet{Wallet outcome?}
    wallet -- protocol error --> post_error[POST wallet error to state-bound callback]
    wallet -- presentation --> post_vp[POST vp_token and presentation_submission to state-bound callback]
    post_error --> error_state{State valid and error supported?}
    error_state -- no --> response_error["`**HTTP 400** local HTML error before trusted redirect URI or **HTTP 302** error at trusted redirect URI`"]
    error_state -- yes --> error_redirect["`**HTTP 302** client redirect with wallet error and state`"]
    post_vp --> validate{State client and redirect URI, mapping, signatures, VP claims, credential, and subject binding valid?}
    validate -- no --> response_error
    validate -- yes --> code{Authorization code generated?}
    code -- no --> response_error
    code -- yes --> success["`**HTTP 302** trusted redirect URI with code and state`"]
