%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    begin[GET /authorize with vp_token] --> verifier["verifier::validate"]
    verifier -- error --> request_error["`**HTTP 400** authorization error`"]
    verifier -- ok --> issuer["credential_issuer::validate"]
    issuer --> definition["presentation_definition::select"]
    definition -- error --> request_error
    definition -- ok --> state["presentation_state::generate"]
    state -- error --> request_error
    state -- ok --> request_object["presentation_request::generate"]
    request_object -- error --> request_error
    request_object -- ok --> authorization["`**HTTP 302** wallet redirect or **HTTP 200** QR relay`"]
    authorization --> wallet{Wallet error or presentation?}
    wallet -- error --> encoding["presentation_submission::validate_encoding"]
    wallet -- presentation --> encoding
    encoding -- error --> local_error["`**HTTP 400** local HTML error`"]
    encoding -- ok --> restore["presentation_state::validate"]
    restore -- error --> local_error
    restore -- ok --> client["client_credentials::validate"]
    client -- error --> local_error
    client -- ok --> kind{Wallet error or presentation?}
    kind -- error --> wallet_error["presentation_submission::validate_wallet_error"]
    kind -- presentation --> submission["presentation_submission::validate"]
    submission -- ok --> presentation["verifiable_presentation::validate"]
    presentation -- ok --> code["authorization_code::generate"]
    wallet_error -- ok --> error_redirect["`**HTTP 302** client wallet-error redirect`"]
    code -- ok --> success["`**HTTP 302** trusted redirect URI with code and state`"]
    wallet_error -- error --> response_error["`**HTTP 302** trusted error redirect`"]
    submission -- error --> response_error
    presentation -- error --> response_error
    code -- error --> response_error
