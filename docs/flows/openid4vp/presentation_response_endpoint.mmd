    shape -- no --> request_error
    shape -- yes --> presentation{Holder presentation JWT valid?}
    presentation -- no --> request_error
    presentation -- yes --> credential{Issuer credential valid and query satisfied?}
    credential -- no --> request_error
    credential -- yes --> binding{Holder, audience, and nonce bound?}
    binding -- no --> request_error
    binding -- yes --> success
