%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    start[Request /presentation-response] --> method{POST?}
    method -- no --> not_found["`**HTTP 404** not found`"]
    method -- yes --> encoding["presentation_submission::validate_encoding"]
    encoding -- error --> html_error["`**HTTP 400** local HTML error`"]
    encoding -- ok --> state["presentation_state::validate"]
    state -- error --> html_error
    state -- ok --> client["client_credentials::validate"]
    client -- error --> html_error
    client -- ok --> kind{Wallet error or vp_token?}
    kind -- wallet error --> wallet_error["presentation_submission::validate_wallet_error"]
    kind -- vp_token --> submission["presentation_submission::validate"]
    submission -- ok --> presentation["verifiable_presentation::validate"]
    presentation -- ok --> code["authorization_code::generate"]
    wallet_error -- ok --> wallet_success["`**HTTP 302** trusted wallet-error redirect`"]
    code -- ok --> success["`**HTTP 302** trusted redirect URI with code and state`"]
    wallet_error -- error --> redirect_error["`**HTTP 302** trusted error redirect`"]
    submission -- error --> redirect_error
    presentation -- error --> redirect_error
    code -- error --> redirect_error
