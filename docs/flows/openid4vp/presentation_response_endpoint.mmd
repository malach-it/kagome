%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    start[Request /presentation-response] --> method{POST request?}
    method -- no --> not_found["`**HTTP 404** not found`"]
    method -- yes --> media{Form Content-Type?}
    media -- no --> request_error["`**HTTP 400** local invalid_request`"]
    media -- yes --> source{State in callback query or form body?}
    source -- no --> request_error
    source -- yes --> state{State valid and current?}
    state -- no --> request_error
    state -- yes --> kind{Response kind?}
    kind -- wallet error --> wallet{Supported error without vp_token?}
    wallet -- no --> redirect_error["`**HTTP 302** client redirect with error, error_description, and state`"]
    wallet -- yes --> redirect_error
    kind -- vp_token --> shape{Standard or credential-bound submission valid?}
    shape -- no --> redirect_error
    shape -- yes --> key{Embedded JWK or valid issuer did:key kid?}
    key -- no --> redirect_error
    key -- yes --> id_key{ID-token key absent or VP signature valid with it?}
    id_key -- no --> redirect_error
    id_key -- yes --> presentation{Signature and standard or compact claims valid?}
    presentation -- no --> redirect_error
    presentation -- yes --> credential{Issuer credential valid and query satisfied?}
    credential -- no --> redirect_error
    credential -- yes --> binding{Holder, audience, and nonce bound?}
    binding -- no --> redirect_error
    binding -- yes --> code{Authorization code generated?}
    code -- no --> redirect_error
    code -- yes --> success["`**HTTP 302** client redirect with code and state`"]
