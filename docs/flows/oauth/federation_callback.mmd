%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    start[Request /federation_callback] --> method{GET?}
    method -- no --> not_found["`**HTTP 404** not found`"]
    method -- yes --> state["federated_server::validate_callback_state"]
    state -- error --> invalid_state["`**HTTP 400** local invalid_request`"]
    state -- ok --> shape["federated_server::validate_callback_shape"]
    shape -- malformed --> redirect_error["`**HTTP 302** client error redirect`"]
    shape -- valid code or error --> consume["federated_server::consume_callback_state"]
    consume -- replay or storage error --> redirect_error
    consume -- consumed --> callback["federated_server::validate_callback"]
    callback -- error --> redirect_error
    callback -- ok --> restore[Restore authorization request from federation state]
    restore -- error --> redirect_error
    restore -- ok --> response_type["response_type::validate"]
    response_type -- error --> redirect_error
    response_type -- ok --> client["client_credentials::validate"]
    client -- error --> redirect_error
    client -- ok --> scope["scope::validate"]
    scope -- error --> redirect_error
    scope -- ok --> pkce["pkce::validate"]
    pkce -- error --> redirect_error
    pkce -- ok --> code["authorization_code::validate_optional"]
    code -- invalid, oversized, or excessive depth --> redirect_error
    code -- absent or valid within depth limit --> policy["metadata_policy::validate"]
    policy -- error --> redirect_error
    policy -- ok --> token["federated_server::request_access_token"]
    token -- error --> redirect_error
    token -- ok --> identity["federated_server::fetch_identity"]
    identity -- error --> redirect_error
    identity -- ok --> generate{Selected response pipeline?}
    generate -- pre-authorized_code --> pre_code["pre_authorized_code::generate"]
    generate -- code --> auth_code["authorization_code::generate"]
    generate -- access token --> access["access_token::generate"]
    generate -- ID token --> id_token["id_token::generate"]
    generate -- combined --> combined[Compose selected generation actions]
    generate -- OpenID4VP --> verifier["verifier::validate"]
    verifier -- error --> redirect_error
    verifier -- ok --> issuer["credential_issuer::validate"]
    issuer -- error --> redirect_error
    issuer -- ok --> definition["presentation_definition::select"]
    definition -- error --> redirect_error
    definition -- ok --> presentation_state["presentation_state::generate"]
    presentation_state -- error --> redirect_error
    presentation_state -- ok --> presentation_request["presentation_request::generate"]
    presentation_request -- error --> redirect_error
    presentation_request -- ok --> consume_optional
    pre_code -- error --> redirect_error
    auth_code -- excessive depth or generation error --> redirect_error
    access -- error --> redirect_error
    id_token -- error --> redirect_error
    combined -- error --> redirect_error
    pre_code -- ok --> consume_optional["authorization_code::consume_optional"]
    auth_code -- ok --> consume_optional
    access -- ok --> consume_optional
    id_token -- ok --> consume_optional
    combined -- ok --> consume_optional
    consume_optional -- replay or storage error --> redirect_error
    consume_optional -- absent or consumed --> delivery{Wallet delivery?}
    delivery -- QR client and no validated ID-token code --> qr["`**HTTP 200** QR relay`"]
    delivery -- validated ID-token code or standard client --> accepted["`**HTTP 302** downstream authorize response`"]
