%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    start[Request /authorize] --> method{HTTP method and flow?}
    method -- other or non-GET vp_token --> not_found["`**HTTP 404** not found`"]
    method -- GET or OAuth POST --> response_type{response_type supported and ordering valid?}
    response_type -- no --> error
    response_type -- yes --> client{Registered client_id, or username@host mapped by public host and redirect_uri?}
    client -- no --> error
    client -- yes --> federated_post{POST and client federated?}
    federated_post -- yes --> error
    federated_post -- no --> code{Incoming chained code absent or valid?}
    code -- no --> error
    code -- yes --> policy{metadata_policy absent or valid?}
    policy -- no --> error
    policy -- yes --> flow{Validated response type?}
    flow -- vp_token --> vp_verifier[Use configured issuer as verifier]
    vp_verifier --> vp_host{Credential issuer Host valid?}
    vp_host -- no --> error
    vp_host -- yes --> vp_state{Fresh presentation nonce and state generated?}
    vp_state -- no --> error
    vp_state -- yes --> vp_sign{Presentation request object signed?}
    vp_sign -- no --> error
    vp_sign -- yes --> vp_success["`**HTTP 302** redirect URI with client_id, response_type, state-bound callback, and signed request`"]
    flow -- OAuth --> get_or_post{GET or POST?}
    get_or_post -- GET --> optional_owner{Optional resource owner credentials valid?}
    optional_owner -- invalid --> error
    optional_owner -- absent --> federation{federated_server configured?}
    federation -- yes --> federated_redirect["`**HTTP 302** federated authorize endpoint with response_type code, client_id, callback redirect_uri, and encrypted parsed request attributes`"]
    federation -- no --> not_implemented["`**HTTP 501** local authentication not implemented`"]
    optional_owner -- valid --> generate
    get_or_post -- POST --> required_owner{Required resource owner credentials valid?}
    required_owner -- no --> error
    required_owner -- yes --> generate{Generate requested response?}
    generate -- no --> error
    generate -- code with remaining stages --> continue_chain["`**HTTP 302** /authorize with code and remaining response_type`"]
    generate -- final code --> code_redirect["`**HTTP 302** client redirect with code`"]
    generate -- token --> token_redirect["`**HTTP 302** client fragment with access_token, token_type, expires_in, and optional state`"]
    generate -- id_token --> id_redirect["`**HTTP 302** client fragment with id_token`"]
    generate -- id_token token --> oidc_redirect["`**HTTP 302** client fragment with id_token and access_token`"]
    generate -- code token --> hybrid_token["`**HTTP 302** client redirect with code and access_token`"]
    generate -- code id_token --> hybrid_id["`**HTTP 302** client redirect with code and id_token`"]
    generate -- code id_token token --> hybrid_all["`**HTTP 302** client redirect with code, id_token, and access_token`"]
    error{Redirect error format available?}
    error -- yes --> error_redirect["`**HTTP 302** client redirect with OAuth error and optional state`"]
    error -- no --> html_error["`**HTTP 400** HTML authorization error`"]
