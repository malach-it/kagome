%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    start[Request /authorize] --> method{GET, POST, or unsupported?}
    method -- POST or unsupported --> not_found["`**HTTP 404** not found`"]
    method -- GET --> response_type["response_type::validate"]
    response_type -- error --> error
    response_type -- ok --> client["client_credentials::validate"]
    client -- error --> error
    client -- ok --> scope["scope::validate"]
    scope -- error --> error
    scope -- ok --> pkce["pkce::validate"]
    pkce -- error --> error
    pkce -- ok --> code["authorization_code::validate_optional"]
    code -- invalid, oversized, or excessive depth --> error
    code -- absent or valid within depth limit --> policy["metadata_policy::validate"]
    policy -- error --> error
    policy -- ok --> local_auth{Local resource-owner validation needed?}
    local_auth -- yes --> owner_optional["resource_owner::validate_optional"]
    owner_optional -- error --> error
    owner_optional -- ok --> flow{Authentication and response pipeline?}
    local_auth -- authenticated, federated, or vp_token --> flow
    flow -- unauthenticated federated client --> federate["federated_server::authorize"]
    federate -- error --> error
    federate -- ok --> federated_redirect["`**HTTP 302** federated authorize endpoint`"]
    flow -- vp_token for authenticated or local client --> verifier["verifier::validate"]
    verifier -- error --> error
    verifier -- ok --> issuer["credential_issuer::validate"]
    issuer -- error --> error
    issuer -- ok --> definition["presentation_definition::select"]
    definition -- error --> error
    definition -- ok --> state["presentation_state::generate"]
    state -- error --> error
    state -- ok --> request_object["presentation_request::generate"]
    request_object -- error --> error
    request_object -- ok --> vp_delivery{QR delivery enabled?}
    vp_delivery -- no --> vp_redirect["`**HTTP 302** wallet redirect with nonce and state only in signed request`"]
    vp_delivery -- yes --> vp_qr["`**HTTP 200** QR relay with nonce and state only in signed request`"]
    flow -- unauthenticated local OAuth GET --> not_implemented["`**HTTP 501** local authentication not implemented`"]
    flow -- authenticated OAuth GET --> generate{Selected response type?}
    generate -- pre-authorized_code --> pre_code["pre_authorized_code::generate"]
    generate -- code --> auth_code["authorization_code::generate"]
    generate -- token --> access["access_token::generate"]
    generate -- id_token --> id_token["id_token::generate"]
    generate -- combined --> combined[Compose selected generation actions]
    pre_code -- error --> error
    auth_code -- excessive depth or generation error --> error
    access -- error --> error
    id_token -- error --> error
    combined -- error --> error
    pre_code -- ok --> consume["authorization_code::consume_optional"]
    auth_code -- ok --> consume
    access -- ok --> consume
    id_token -- ok --> consume
    combined -- ok --> consume
    consume -- replay or storage error --> error
    consume -- absent or consumed --> generated_response{Generated response kind?}
    generated_response -- credential offer --> offer_delivery{QR delivery enabled?}
    offer_delivery -- no --> offer_redirect["`**HTTP 302** credential offer with exact state`"]
    offer_delivery -- yes --> offer_qr["`**HTTP 200** credential-offer QR relay`"]
    generated_response -- code --> code_response["`**HTTP 302** code response or continuation with exact state`"]
    generated_response -- access token --> token_response["`**HTTP 302** access-token response with exact state`"]
    generated_response -- ID token --> id_response["`**HTTP 302** ID-token response with exact state`"]
    generated_response -- combined --> combined_response["`**HTTP 302** combined response with exact state`"]
    error{Trusted redirect URI and state?}
    error -- yes --> redirect_error["`**HTTP 302** authorization error with exact state`"]
    error -- no --> html_error["`**HTTP 400** HTML authorization error`"]
