%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    start[GET or POST /authorize with response_type token] --> request{Registered client or public username@host with matching redirect?}
    request -- no --> request_error["`**HTTP 400** HTML authorization error or **HTTP 302** error redirect after client and redirect_uri revalidation`"]
    request -- yes --> method{Request method?}
    method -- GET --> optional_owner{Resource owner credentials embedded in client_id and valid for client password file?}
    optional_owner -- absent --> federation{Client has federated_server?}
    federation -- yes --> federated_redirect["`**HTTP 302** federated authorize endpoint with response_type code, client_id, callback redirect_uri, and encrypted parsed request attributes`"]
    federation -- no --> not_implemented["`**HTTP 501** local authentication not implemented`"]
    optional_owner -- invalid --> owner_error["`**HTTP 302** or **HTTP 400** resource owner error preserving optional state`"]
    optional_owner -- valid --> generate
    method -- POST --> federated_post{Client has federated_server?}
    federated_post -- yes --> request_error
    federated_post -- no --> required_owner{Submitted username and password valid for client password file?}
    required_owner -- no --> owner_error
    required_owner -- yes --> generate{Access token generated?}
    generate -- no --> generation_error["`**HTTP 400** invalid_token_response`"]
    generate -- yes --> redirect["`**HTTP 302** client fragment with access_token, token_type, expires_in, and optional state`"]
