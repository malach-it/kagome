%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    start[POST /token] --> grant{grant_type is password?}
    grant -- no --> unsupported["`**HTTP 400** unsupported_grant_type`"]
    grant -- yes --> client_id{client_id present?}
    client_id -- no --> missing_client["`**HTTP 400** invalid_client: client_id required`"]
    client_id -- yes --> client_valid{client_id valid?}
    client_valid -- no --> invalid_client["`**HTTP 400** invalid_client: client_id invalid`"]
    client_valid -- yes --> secret{client_secret present?}
    secret -- no --> missing_secret["`**HTTP 400** invalid_client: client_secret required`"]
    secret -- yes --> secret_valid{client_secret valid?}
    secret_valid -- no --> invalid_secret["`**HTTP 400** invalid_client: client_secret invalid`"]
    secret_valid -- yes --> password_file{Client has nginx-style password file?}
    password_file -- no --> invalid_username
    password_file -- yes --> username{username present?}
    username -- no --> missing_username["`**HTTP 400** invalid_grant: username required`"]
    username -- yes --> username_valid{username present in client password file?}
    username_valid -- no --> invalid_username["`**HTTP 400** invalid_grant: username invalid`"]
    username_valid -- yes --> password{password present?}
    password -- no --> missing_password["`**HTTP 400** invalid_grant: password required`"]
    password -- yes --> password_valid{password matches configured hash?}
    password_valid -- no --> invalid_password["`**HTTP 400** invalid_grant: password invalid`"]
    password_valid -- yes --> generate{COSE_Encrypt0 access token generated?}
    generate -- no --> generation_error["`**HTTP 400** invalid_token_response`"]
    generate -- yes --> success["`**HTTP 200** opaque COSE_Encrypt0 resource-owner bearer access token`"]
