%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    start[POST /token] --> grant{grant_type is client_credentials?}
    grant -- no --> unsupported["`**HTTP 400** unsupported_grant_type`"]
    grant -- yes --> client_id{client_id present?}
    client_id -- no --> missing_client["`**HTTP 400** invalid_client: client_id required`"]
    client_id -- yes --> client_valid{client_id configured?}
    client_valid -- no --> invalid_client["`**HTTP 400** invalid_client: client_id invalid`"]
    client_valid -- yes --> secret{client_secret present?}
    secret -- no --> missing_secret["`**HTTP 400** invalid_client: client_secret required`"]
    secret -- yes --> secret_valid{client_secret matches configured client?}
    secret_valid -- no --> invalid_secret["`**HTTP 400** invalid_client: client_secret invalid`"]
    secret_valid -- yes --> generate{access token generated?}
    generate -- no --> generation_error["`**HTTP 400** invalid_token_response`"]
    generate -- yes --> success["`**HTTP 200** bearer access token`"]
