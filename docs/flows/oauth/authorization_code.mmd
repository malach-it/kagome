%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    start[GET or POST /authorize] --> response_type["response_type::validate"]
    response_type -- error --> authorize_error["`**HTTP 400** HTML error or **HTTP 302** trusted redirect`"]
    response_type -- ok --> client["client_credentials::validate"]
    client -- error --> authorize_error
    client -- ok --> previous["authorization_code::validate_optional"]
    previous -- error --> authorize_error
    previous -- ok --> policy["metadata_policy::validate"]
    policy -- error --> authorize_error
    policy -- ok --> method{GET or POST?}
    method -- GET --> owner_optional["resource_owner::validate_optional"]
    owner_optional -- error --> authorize_error
    owner_optional -- absent --> federation{federated_server configured?}
    federation -- yes --> federate["federated_server::authorize"]
    federate -- error --> authorize_error
    federate -- ok --> federated_redirect["`**HTTP 302** federated authorize endpoint`"]
    federation -- no --> not_implemented["`**HTTP 501** local authentication not implemented`"]
    owner_optional -- present --> issue
    method -- POST --> owner["resource_owner::validate"]
    owner -- error --> authorize_error
    owner -- ok --> issue["authorization_code::generate"]
    issue -- error --> authorize_error
    issue -- ok --> redirect["`**HTTP 302** client redirect with code`"]
    redirect --> token[POST /token]
    token --> grant["grant_type::validate"]
    grant -- error --> token_error["`**HTTP 400** OAuth error`"]
    grant -- authorization_code --> token_client["client_credentials::validate"]
    token_client -- error --> token_error
    token_client -- ok --> code["authorization_code::validate"]
    code -- error --> token_error
    code -- ok --> access["access_token::generate"]
    access -- error --> token_error
    access -- ok --> success["`**HTTP 200** opaque COSE_Encrypt0 bearer access token`"]
