%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
flowchart TD
    start[Request /token] --> method{Method?}
    method -- other --> not_found["`**HTTP 404** not found`"]
    method -- OPTIONS --> preflight_origin{Configured CORS origin allowed?}
    preflight_origin -- yes --> preflight["`**HTTP 204** CORS preflight response`"]
    preflight_origin -- no --> plain_preflight["`**HTTP 204** response without CORS headers`"]
    method -- POST --> grant["grant_type::validate"]
    grant -- error --> oauth_error["`**HTTP 400** OAuth error without CORS header`"]
    grant -- client_credentials --> client["client_credentials::validate"]
    grant -- password --> password_client["client_credentials::validate"]
    password_client -- ok --> password_scope["scope::validate"]
    password_scope -- ok --> owner["resource_owner::validate"]
    grant -- authorization_code --> code_client["client_credentials::validate"]
    code_client -- ok --> code_scope["scope::validate"]
    code_scope -- ok --> code["authorization_code::validate"]
    code -- valid within depth limit --> pkce["pkce::verify"]
    pkce -- ok --> consume_code["authorization_code::consume"]
    grant -- code_chain --> chain_client["client_credentials::validate"]
    chain_client -- ok --> chain_scope["scope::validate"]
    chain_scope -- ok --> previous["authorization_code::validate_optional"]
    previous -- absent or valid within depth limit --> id_token["id_token::validate"]
    id_token -- ok --> issue["authorization_code::generate"]
    grant -- pre-authorized_code --> pre_code["pre_authorized_code::validate"]
    pre_code -- ok --> consume_pre_code["pre_authorized_code::consume"]
    consume_pre_code -- ok --> credential_access["credential_access_token::generate"]
    client -- ok --> client_scope["scope::validate"]
    client_scope -- ok --> access["access_token::generate"]
    owner -- ok --> access
    consume_code -- ok --> access
    issue -- ok --> code_success["`**HTTP 200** authorization code without CORS header`"]
    credential_access -- ok --> credential_success_origin{Configured CORS origin allowed?}
    access -- ok --> access_success["`**HTTP 200** bearer access token without CORS header`"]
    client -- error --> oauth_error
    client_scope -- error --> oauth_error
    password_client -- error --> oauth_error
    password_scope -- error --> oauth_error
    owner -- error --> oauth_error
    code_client -- error --> oauth_error
    code_scope -- error --> oauth_error
    code -- invalid, oversized, or excessive depth --> oauth_error
    pkce -- error --> oauth_error
    consume_code -- replay or storage error --> oauth_error
    chain_client -- error --> oauth_error
    chain_scope -- error --> oauth_error
    previous -- invalid, oversized, or excessive depth --> oauth_error
    id_token -- error --> oauth_error
    issue -- excessive depth or generation error --> oauth_error
    pre_code -- error --> credential_error_origin{Configured CORS origin allowed?}
    consume_pre_code -- replay or storage error --> credential_error_origin
    credential_access -- error --> credential_error_origin
    credential_error_origin -- yes --> credential_cors_error["`**HTTP 400** credential access token OAuth error with CORS header`"]
    credential_error_origin -- no --> credential_oauth_error["`**HTTP 400** credential access token OAuth error without CORS header`"]
    credential_success_origin -- yes --> credential_cors_success["`**HTTP 200** credential access token with CORS header`"]
    credential_success_origin -- no --> credential_access_success["`**HTTP 200** credential access token without CORS header`"]
    access -- error --> oauth_error
